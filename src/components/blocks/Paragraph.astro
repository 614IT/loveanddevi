---
import { TinaMarkdown } from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  block: any;
  index: number;
  parentField?: string;
}

const { block, index, parentField = 'blocks' } = Astro.props;
---

<div class="paragraph" data-tina-field={tinaField(block, 'body')}>
  <TinaMarkdown content={block.body} />
</div>
