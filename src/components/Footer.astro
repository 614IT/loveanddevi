---
import site from '../data/site.json';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div>
      <h4>{site.title}</h4>
      <p>{site.tagline}</p>
      {site.contact_email && (
        <p><a href={`mailto:${site.contact_email}`}>{site.contact_email}</a></p>
      )}
    </div>
    <div>
      <h4>Explore</h4>
      {site.nav.map((item) => (
        <div><a href={item.href}>{item.label}</a></div>
      ))}
    </div>
    <div class="footer-bottom">© {year} {site.title}. All rights reserved.</div>
  </div>
</footer>
