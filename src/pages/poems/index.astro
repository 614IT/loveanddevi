---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const poems = (await getCollection('poems', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
---

<PageLayout title="Poems" layout="wide">
  {poems.length === 0 ? (
    <p style="text-align:center;">No poems yet.</p>
  ) : (
    <div class="card-grid">
      {poems.map((p) => (
        <article class="card">
          <a href={`/poems/${p.id}/`}>
            {p.data.image && <div class="card-image"><img src={p.data.image} alt={p.data.title} /></div>}
            <div class="card-body">
              <h3>{p.data.title}</h3>
              {p.data.date && <div class="meta">{p.data.date.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' })}</div>}
            </div>
          </a>
        </article>
      ))}
    </div>
  )}
</PageLayout>
