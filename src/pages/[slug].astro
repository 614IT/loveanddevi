---
import { decodeSlug, getEmDashEntry, getSeoMeta } from "emdash";
import Base from "../layouts/Base.astro";
import PageView from "../components/PageView.astro";
import { EmVBPage, resolveEmVBPage } from "@perkyzz/emvb/astro";
import { EmVBFormsRuntime } from "@perkyzz/emvb/astro/forms";
import { EmVBMenuRuntime } from "@perkyzz/emvb/astro/menu";
import { EmVBTabsRuntime } from "@perkyzz/emvb/astro/tabs";
import { heroSeoDefaults } from "../utils/page";

// Try EmVB first. If this URL has an EmVB page, render it below.
const emvb = await resolveEmVBPage(Astro);

// Fall back to EmDash page collection
const slug = decodeSlug(Astro.params.slug);
const emdashEntry = slug ? await getEmDashEntry("pages", slug) : null;

// If neither match, 404
if (!emvb && !emdashEntry?.entry) {
	return Astro.rewrite("/404");
}

const page = emdashEntry?.entry;
if (page && Astro.cache?.enabled) Astro.cache.set(emdashEntry.cacheHint);

const seo = page
	? getSeoMeta(page, {
		siteUrl: Astro.url.origin,
		path: `/${page.id}`,
		...heroSeoDefaults(page.data.content, Astro.url.origin),
	})
	: null;
---

{emvb ? (
	<EmVBPage page={emvb}>
		{emvb.needsFormsRuntime && <EmVBFormsRuntime />}
		{emvb.needsTabsRuntime && <EmVBTabsRuntime />}
		{emvb.needsMenuRuntime && <EmVBMenuRuntime />}
	</EmVBPage>
) : page && seo && (
	<Base
		title={seo.title}
		pageTitle={page.data.title}
		description={seo.description}
		image={seo.ogImage}
		canonical={seo.canonical}
		robots={seo.robots}
		content={{ collection: "pages", id: page.data.id, slug: page.id }}
	>
		<PageView page={page} />
	</Base>
)}
