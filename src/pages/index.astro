---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import site from '../data/site.json';

const homeEntry = await getEntry('pages', 'home');
const HomeContent = homeEntry ? (await render(homeEntry)).Content : null;
const heroImage = homeEntry?.data.hero_image;

const poems = (await getCollection('poems', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 3);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 3);
---

<BaseLayout image={heroImage}>
  <section class="hero" style={heroImage ? `background-image: url('${heroImage}');` : undefined}>
    <div>
      <h1>{site.title}</h1>
      <p class="tagline">{site.tagline}</p>
    </div>
  </section>

  {HomeContent && (
    <section class="prose" style="padding: 1rem 1.25rem 2rem;">
      <HomeContent />
    </section>
  )}

  {poems.length > 0 && (
    <section class="container" style="padding: 2rem 1.25rem;">
      <h2 style="text-align:center;">Recent poems</h2>
      <div class="card-grid">
        {poems.map((p) => (
          <article class="card">
            <a href={`/poems/${p.id}/`}>
              {p.data.image && <div class="card-image"><img src={p.data.image} alt={p.data.title} /></div>}
              <div class="card-body">
                <h3>{p.data.title}</h3>
                {p.data.date && <div class="meta">{p.data.date.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' })}</div>}
              </div>
            </a>
          </article>
        ))}
      </div>
      <p style="text-align:center;"><a href="/poems/" class="btn btn-outline">All poems</a></p>
    </section>
  )}

  {posts.length > 0 && (
    <section class="container" style="padding: 2rem 1.25rem;">
      <h2 style="text-align:center;">From the blog</h2>
      <div class="card-grid">
        {posts.map((p) => (
          <article class="card">
            <a href={`/blog/${p.id}/`}>
              {p.data.image && <div class="card-image"><img src={p.data.image} alt={p.data.title} /></div>}
              <div class="card-body">
                <h3>{p.data.title}</h3>
                {p.data.date && <div class="meta">{p.data.date.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' })}</div>}
                {p.data.excerpt && <div class="excerpt">{p.data.excerpt}</div>}
              </div>
            </a>
          </article>
        ))}
      </div>
      <p style="text-align:center;"><a href="/blog/" class="btn btn-outline">All posts</a></p>
    </section>
  )}
</BaseLayout>
