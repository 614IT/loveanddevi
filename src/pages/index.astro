---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import site from '../data/site.json';

const homeEntry = await getEntry('pages', 'home');
const HomeContent = homeEntry ? (await render(homeEntry)).Content : null;
const heroImage = homeEntry?.data.hero_image;
---

<BaseLayout image={heroImage}>
  <section class="hero" style={heroImage ? `background-image: url('${heroImage}');` : undefined}>
    <p class="tagline">{site.tagline}</p>
  </section>

  {HomeContent && (
    <section class="home-content">
      <HomeContent />
    </section>
  )}
</BaseLayout>
