---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
---

<PageLayout title="Blog" layout="wide">
  {posts.length === 0 ? (
    <p style="text-align:center;">No posts yet.</p>
  ) : (
    <div class="card-grid">
      {posts.map((p) => (
        <article class="card">
          <a href={`/blog/${p.id}/`}>
            {p.data.image && <div class="card-image"><img src={p.data.image} alt={p.data.title} /></div>}
            <div class="card-body">
              <h3>{p.data.title}</h3>
              {p.data.date && <div class="meta">{p.data.date.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' })}</div>}
              {p.data.excerpt && <div class="excerpt">{p.data.excerpt}</div>}
            </div>
          </a>
        </article>
      ))}
    </div>
  )}
</PageLayout>
