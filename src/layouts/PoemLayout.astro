---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date?: Date;
  image?: string;
}

const { title, date, image } = Astro.props;
const dateStr = date ? date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : null;
---

<BaseLayout title={title} image={image}>
  <article class="prose" style="padding: 4rem 1.25rem;">
    <h1 style="text-align: center;">{title}</h1>
    {dateStr && <p style="text-align: center; font-family: var(--font-sans); color: var(--color-text-soft); text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.08em;">{dateStr}</p>}
    {image && <figure><img src={image} alt={title} /></figure>}
    <div class="poem">
      <slot />
    </div>
    <hr />
    <p style="text-align: center; font-family: var(--font-sans); font-size: 0.9rem;">
      <a href="/poems/">← All poems</a>
    </p>
  </article>
</BaseLayout>
