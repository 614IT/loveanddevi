---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date?: Date;
  image?: string;
  excerpt?: string;
}

const { title, date, image, excerpt } = Astro.props;
const dateStr = date ? date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : null;
---

<BaseLayout title={title} description={excerpt} image={image}>
  <article class="prose" style="padding: 3rem 1.25rem;">
    <header style="text-align: center; margin-bottom: 2rem;">
      <h1>{title}</h1>
      {dateStr && <p style="font-family: var(--font-sans); color: var(--color-text-soft); text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.08em;">{dateStr}</p>}
    </header>
    {image && <figure><img src={image} alt={title} /></figure>}
    <slot />
    <hr />
    <p style="text-align: center; font-family: var(--font-sans); font-size: 0.9rem;">
      <a href="/blog/">← All posts</a>
    </p>
  </article>
</BaseLayout>
