---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  hero_image?: string;
  description?: string;
  layout?: 'default' | 'wide' | 'centered';
}

const { title, hero_image, description, layout = 'default' } = Astro.props;
const wrapClass = layout === 'wide' ? 'container' : 'prose';
---

<BaseLayout title={title} description={description} image={hero_image}>
  <section
    class={"page-hero" + (hero_image ? '' : ' no-image')}
    style={hero_image ? `background-image: url('${hero_image}');` : undefined}
  >
    <h1>{title}</h1>
  </section>
  <article class={wrapClass} style="padding-top: 3rem; padding-bottom: 3rem;">
    <slot />
  </article>
</BaseLayout>
