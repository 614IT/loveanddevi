---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  hero_image?: string;
  description?: string;
  layout?: 'default' | 'wide' | 'centered';
  body_bg?: string;
  body_text?: string;
}

const { title, hero_image, description, layout = 'default', body_bg, body_text } = Astro.props;
const wrapClass = layout === 'wide' ? 'container' : 'prose';
const bodyStyle = [
  body_bg ? `background: ${body_bg};` : '',
  body_text ? `color: ${body_text};` : '',
].join(' ');
---

<BaseLayout title={title} description={description} image={hero_image}>
  <section
    class={"page-hero" + (hero_image ? '' : ' no-image')}
    style={hero_image ? `background-image: url('${hero_image}');` : undefined}
  >
    <h1>{title}</h1>
  </section>
  <section class="page-body" style={bodyStyle}>
    <article class={wrapClass} style="padding-top: 3rem; padding-bottom: 4rem;">
      <slot />
    </article>
  </section>
</BaseLayout>
