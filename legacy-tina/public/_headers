# Weebly exported some CSS files without a .css extension (css-1 … css-14).
# Cloudflare Pages defaults their Content-Type to application/octet-stream,
# which modern browsers refuse to apply as stylesheets under strict MIME
# checking. Force the correct MIME so the original fonts/typography load.

/css-1
  Content-Type: text/css; charset=utf-8
