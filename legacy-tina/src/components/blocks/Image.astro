---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props { block: any; }
const { block } = Astro.props;
const align = block.align || 'center';
const floatMap: Record<string, string> = {
  left: 'float:left;margin:10px 20px 10px 0;',
  right: 'float:right;margin:10px 0 10px 20px;',
  center: 'text-align:center;margin:20px auto;',
};
---

<div
  class="wsite-image wsite-image-border-none"
  style={`padding:10px 0;${floatMap[align]}`}
  data-tina-field={tinaField(block, 'src')}
>
  <img src={block.src} alt={block.alt || ''} style="max-width:100%;height:auto;" />
  {block.caption && (
    <div style="font-size:90%;color:#666;margin-top:6px;" data-tina-field={tinaField(block, 'caption')}>
      {block.caption}
    </div>
  )}
</div>
