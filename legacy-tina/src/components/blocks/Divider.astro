---
interface Props { block: any; }
const { block } = Astro.props;
const style = block.style || 'line';
const heights: Record<string, number> = { small: 20, large: 60 };
---

{style === 'line' ? (
  <hr style="border:0;border-top:1px solid #ddd;margin:2em auto;max-width:200px;" />
) : (
  <div class="wsite-spacer" style={`height:${heights[style] ?? 20}px;`} />
)}
